(version 1)

(rule "J2 USB-C connector NPTH-to-GND-pad clearance"
    (condition "A.memberOfFootprint('J2') || B.memberOfFootprint('J2')")
    (constraint hole_clearance (min 0.15mm))
)

(rule "SD1 microSD connector board-edge clearance"
    (condition "A.memberOfFootprint('SD1')")
    (constraint edge_clearance (min 0.2mm))
)
